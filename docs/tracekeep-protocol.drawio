<mxfile host="app.diagrams.net"><diagram id="Protocol" name="Protocol"><mxGraphModel dx="1100" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;tracekeep&lt;/b&gt; &amp;mdash; protocol and hash chain" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="500" height="30" as="geometry"/></mxCell><mxCell id="fl" value="&lt;b&gt;1. Every frame on the wire&lt;/b&gt; (8-byte header, big-endian)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="600" height="24" as="geometry"/></mxCell><mxCell id="f0" value="&lt;b&gt;magic&lt;br&gt;&amp;quot;TK&amp;quot;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="90" height="64" as="geometry"/></mxCell><mxCell id="fs0" value="2 bytes" style="text;html=1;align=center;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="166" width="90" height="20" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;version&lt;br&gt;1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="100" width="80" height="64" as="geometry"/></mxCell><mxCell id="fs1" value="1 byte" style="text;html=1;align=center;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="110" y="166" width="80" height="20" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;type&lt;br&gt;HELLO / RECORD&lt;br&gt;ACK / ERROR&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="130" height="64" as="geometry"/></mxCell><mxCell id="fs2" value="1 byte" style="text;html=1;align=center;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="190" y="166" width="130" height="20" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;payload length&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="140" height="64" as="geometry"/></mxCell><mxCell id="fs3" value="4 bytes" style="text;html=1;align=center;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="166" width="140" height="20" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;payload&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="300" height="64" as="geometry"/></mxCell><mxCell id="fs4" value="0 to 64 KiB" style="text;html=1;align=center;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="460" y="166" width="300" height="20" as="geometry"/></mxCell><mxCell id="fnote" value="The length field is computed from the payload, so the header fits any message. The receiver checks all 8 header bytes &lt;b&gt;before&lt;/b&gt; reading the payload: a header claiming 4 GiB is refused at once." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="192" width="740" height="36" as="geometry"/></mxCell><mxCell id="rl" value="&lt;b&gt;2. A RECORD payload&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="245" width="400" height="24" as="geometry"/></mxCell><mxCell id="r0" value="&lt;b&gt;seq&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="275" width="90" height="44" as="geometry"/></mxCell><mxCell id="rs0" value="8 bytes" style="text;html=1;align=center;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="321" width="90" height="20" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;time (ms)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="275" width="100" height="44" as="geometry"/></mxCell><mxCell id="rs1" value="8 bytes" style="text;html=1;align=center;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="110" y="321" width="100" height="20" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;prev hash&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="275" width="160" height="44" as="geometry"/></mxCell><mxCell id="rs2" value="32 bytes" style="text;html=1;align=center;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="210" y="321" width="160" height="20" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;MAC&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="275" width="160" height="44" as="geometry"/></mxCell><mxCell id="rs3" value="32 bytes" style="text;html=1;align=center;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="370" y="321" width="160" height="20" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;message (UTF-8)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="275" width="230" height="44" as="geometry"/></mxCell><mxCell id="rs4" value="up to 8 KiB" style="text;html=1;align=center;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="530" y="321" width="230" height="20" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;3. The hash chain&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="365" width="400" height="24" as="geometry"/></mxCell><mxCell id="c0" value="&lt;b&gt;record 0&lt;/b&gt;&lt;br&gt;prev = 000...0&lt;br&gt;message&lt;br&gt;MAC = HMAC(key, hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="395" width="200" height="90" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;record 1&lt;/b&gt;&lt;br&gt;prev = hash(record 0)&lt;br&gt;message&lt;br&gt;MAC = HMAC(key, hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="395" width="200" height="90" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;record 2&lt;/b&gt;&lt;br&gt;prev = hash(record 1)&lt;br&gt;message&lt;br&gt;MAC = HMAC(key, hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="395" width="200" height="90" as="geometry"/></mxCell><mxCell id="ce0" value="hash" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c0" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ce1" value="hash" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cnote" value="Changing any record changes its hash, so its MAC no longer matches and the next record&#x27;s &lt;i&gt;prev&lt;/i&gt; no longer links. Rebuilding the chain needs the secret key, which an attacker does not have." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="495" width="740" height="36" as="geometry"/></mxCell><mxCell id="sl" value="&lt;b&gt;4. One connection&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="555" width="400" height="24" as="geometry"/></mxCell><mxCell id="ship" value="&lt;b&gt;shipper&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="160" height="40" as="geometry"/></mxCell><mxCell id="coll" value="&lt;b&gt;collector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;127.0.0.1:5140&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="540" y="600" width="160" height="40" as="geometry"/></mxCell><mxCell id="lsh" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="640" as="sourcePoint"/><mxPoint x="160" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lco" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="640" as="sourcePoint"/><mxPoint x="620" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m0" value="HELLO &amp;quot;web01&amp;quot;" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="680" as="sourcePoint"/><mxPoint x="620" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m1" value="ACK next seq 0, last hash 000...0 &amp;nbsp;(or where a stored chain ends)" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="720" as="sourcePoint"/><mxPoint x="160" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2" value="RECORD seq 0" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="780" as="sourcePoint"/><mxPoint x="620" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3" value="ACK (checked and written to web01.jsonl)" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="820" as="sourcePoint"/><mxPoint x="160" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4" value="RECORD seq 1 ..." style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="870" as="sourcePoint"/><mxPoint x="620" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5" value="ACK" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="905" as="sourcePoint"/><mxPoint x="160" y="905" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m6" value="RECORD with a wrong MAC, a replay, or garbage" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="960" as="sourcePoint"/><mxPoint x="620" y="960" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7" value="ERROR &amp;quot;record 2 has an invalid MAC&amp;quot;, then close; nothing stored" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1000" as="sourcePoint"/><mxPoint x="160" y="1000" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue = header fields, green = payload&lt;br&gt;yellow = sealed records&lt;br&gt;solid arrow = request, dashed = reply" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="260" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
